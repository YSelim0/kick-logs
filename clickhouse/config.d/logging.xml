<?xml version="1.0"?>
<clickhouse>
    <!-- Keep actionable diagnostics without per-query trace output. -->
    <logger>
        <level>warning</level>
        <console>1</console>
        <console_log_level>warning</console_log_level>
        <size>10M</size>
        <count>3</count>
    </logger>

    <!-- Remove historical collectors, not live system tables or application data.
         Existing log tables remain on disk until explicitly cleaned by an operator. -->
    <query_log remove="1" />
    <query_thread_log remove="1" />
    <query_views_log remove="1" />
    <trace_log remove="1" />
    <text_log remove="1" />
    <part_log remove="1" />
    <metric_log remove="1" />
    <asynchronous_metric_log remove="1" />
    <error_log remove="1" />
    <processors_profile_log remove="1" />
    <asynchronous_insert_log remove="1" />
    <opentelemetry_span_log remove="1" />

    <!-- No allocation stack samples without a trace collector. -->
    <total_memory_profiler_step>0</total_memory_profiler_step>
</clickhouse>
