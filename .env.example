APP_NAME=Kick Logs
APP_ENV=local
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

POSTGRES_DB=kick_logs
POSTGRES_USER=kick_logs
POSTGRES_PASSWORD=kick_logs
POSTGRES_PORT=5432
PYTHON_API_PORT=8002
DATABASE_URL=postgresql+asyncpg://kick_logs:kick_logs@postgres:5432/kick_logs
POSTGRES_SOURCE_DSN=postgresql://kick_logs:kick_logs@postgres:5432/kick_logs
DATABASE_ECHO=false

JWT_SECRET_KEY=change-me-for-local-development-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080
JWT_COOKIE_NAME=kick_logs_session
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=lax
SEED_SUPER_ADMIN_ON_STARTUP=true

DEFAULT_SUPER_ADMIN_EMAIL=admin@kicklogs.local
DEFAULT_SUPER_ADMIN_PASSWORD=admin123

KICK_PUSHER_URL=wss://ws-us2.pusher.com/app/32cbd69e4b950bf97679?protocol=7&client=js&version=8.4.0-rc2&flash=false
LISTENER_RECONNECT_INITIAL_DELAY_SECONDS=1
LISTENER_RECONNECT_MAX_DELAY_SECONDS=30
LISTENER_RECONNECT_MULTIPLIER=2
LISTENER_WORKER_COUNT=4
LISTENER_RAW_EVENT_BATCH_SIZE=100
LISTENER_RAW_EVENT_PROCESSING_TIMEOUT_SECONDS=300
LISTENER_RAW_EVENT_MAX_ATTEMPTS=5
LISTENER_RAW_EVENT_WORKER_IDLE_DELAY_SECONDS=0.25
LISTENER_CHANNEL_RESYNC_INTERVAL_SECONDS=60
LISTENER_HEARTBEAT_INTERVAL_SECONDS=15
LISTENER_HEARTBEAT_STALE_AFTER_SECONDS=45

MESSAGE_EXPORT_MAX_ROWS=1000

# Go + ClickHouse storage
SQLITE_PATH=/data/kick-logs-go.sqlite3
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_ADDR=clickhouse:9000
CLICKHOUSE_DATABASE=kick_logs
CLICKHOUSE_USERNAME=kick_logs
CLICKHOUSE_PASSWORD=kick_logs
CLICKHOUSE_DEBUG=false
KICK_LOGS_RUN_CLICKHOUSE_TESTS=0
