APP_NAME=Kick Logs
APP_ENV=local
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Host interface the published container ports bind to. Default 127.0.0.1 keeps
# the API/web/ClickHouse reachable only by a reverse proxy on the same host. If
# you run without a local proxy and need direct external access, set to 0.0.0.0.
API_BIND_HOST=127.0.0.1
WEB_BIND_HOST=127.0.0.1
CH_BIND_HOST=127.0.0.1

JWT_SECRET_KEY=change-me-for-local-development-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080
JWT_COOKIE_NAME=kick_logs_session
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=lax
SEED_SUPER_ADMIN_ON_STARTUP=true

DEFAULT_SUPER_ADMIN_EMAIL=admin@kicklogs.local
DEFAULT_SUPER_ADMIN_PASSWORD=admin123

KICK_PUSHER_URL=wss://ws-us2.pusher.com/app/32cbd69e4b950bf97679?protocol=7&client=js&version=8.4.0-rc2&flash=false
LISTENER_RECONNECT_INITIAL_DELAY_SECONDS=1
LISTENER_RECONNECT_MAX_DELAY_SECONDS=30
LISTENER_RECONNECT_MULTIPLIER=2
LISTENER_WORKER_COUNT=4
LISTENER_RAW_EVENT_BATCH_SIZE=500
LISTENER_RAW_EVENT_PROCESSING_TIMEOUT_SECONDS=300
LISTENER_RAW_EVENT_MAX_ATTEMPTS=5
LISTENER_RAW_EVENT_WORKER_IDLE_DELAY_SECONDS=0.25
LISTENER_CHANNEL_RESYNC_INTERVAL_SECONDS=60
LISTENER_HEARTBEAT_INTERVAL_SECONDS=15
LISTENER_HEARTBEAT_STALE_AFTER_SECONDS=45
LISTENER_RAW_EVENT_WRITE_BATCH_SIZE=1000
LISTENER_RAW_EVENT_WRITE_FLUSH_INTERVAL_MS=1500
LISTENER_RAW_EVENT_WRITE_QUEUE_SIZE=50000
LISTENER_RAW_EVENT_WRITE_MAX_RETRIES=10
LISTENER_CLICKHOUSE_BACKOFF_INITIAL_MS=1000
LISTENER_CLICKHOUSE_BACKOFF_MAX_MS=30000
LISTENER_CLICKHOUSE_BACKOFF_MULTIPLIER=2
LISTENER_CLICKHOUSE_BREAKER_FAILURE_THRESHOLD=5

MESSAGE_EXPORT_MAX_ROWS=1000

# Rate limiting (GCRA, in-memory). RATE_LIMIT_TRUST_PROXY trusts
# RATE_LIMIT_CLIENT_IP_HEADER for the real client IP — keep it true only when the
# API is reachable solely through your trusted reverse proxy (loopback bind +
# firewall). CF-Connecting-IP behind Cloudflare; X-Real-IP / X-Forwarded-For
# behind a plain nginx proxy.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORE_MAX_KEYS=65536
RATE_LIMIT_TRUST_PROXY=true
RATE_LIMIT_CLIENT_IP_HEADER=CF-Connecting-IP

# Go + ClickHouse storage
SQLITE_PATH=/data/kick-logs-go.sqlite3
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_ADDR=clickhouse:9000
CLICKHOUSE_DATABASE=kick_logs
CLICKHOUSE_USERNAME=kick_logs
CLICKHOUSE_PASSWORD=kick_logs
CLICKHOUSE_DEBUG=false
KICK_LOGS_RUN_CLICKHOUSE_TESTS=0

# Legacy import only. Point this at an external/restored PostgreSQL source before running:
# docker compose --profile tools run --rm migrate-go -target=data -execute
POSTGRES_SOURCE_DSN=

# Kick webhook subscription tracking (issue #22).
# Obtain client credentials from the Kick Developer panel.
# KICK_WEBHOOK_PUBLIC_KEY: copy the public key from the Kick Developer panel.
# If credentials are missing, the API still starts but subscription sync is disabled.
# If the public key is missing, POST /webhooks/kick fails closed (signatures cannot be verified).
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_API_BASE_URL=https://api.kick.com
KICK_OAUTH_TOKEN_URL=https://id.kick.com/oauth/token
KICK_WEBHOOK_PUBLIC_KEY=
KICK_WEBHOOK_SYNC_ENABLED=true
KICK_WEBHOOK_EVENTS=channel.subscription.new,channel.subscription.renewal,channel.subscription.gifts
KICK_WEBHOOK_PROCESS_BATCH_SIZE=50
KICK_WEBHOOK_PROCESS_MAX_ATTEMPTS=5
