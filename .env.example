APP_NAME=Kick Logs
APP_ENV=local
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000

POSTGRES_DB=kick_logs
POSTGRES_USER=kick_logs
POSTGRES_PASSWORD=kick_logs
DATABASE_URL=postgresql+asyncpg://kick_logs:kick_logs@postgres:5432/kick_logs
DATABASE_ECHO=false

JWT_SECRET_KEY=change-me-for-local-development-secret
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080
JWT_COOKIE_NAME=kick_logs_session
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=lax
SEED_SUPER_ADMIN_ON_STARTUP=true

DEFAULT_SUPER_ADMIN_EMAIL=admin@kicklogs.local
DEFAULT_SUPER_ADMIN_PASSWORD=admin123
